---
// Media frame. Pass `src` for a real image (put files in /public/images).
// Without `src` it shows a labeled placeholder you can replace later.
const { src, alt = '', label = 'Image', ratio = '16 / 9', tc = '00:00:00:00' } = Astro.props;
---
<figure class="frame" style={`aspect-ratio:${ratio}`}>
  {src
    ? <img src={src} alt={alt} loading="lazy" />
    : <div class="ph"><span>{label}</span></div>}
  <span class="corner tl"></span><span class="corner tr"></span>
  <span class="corner bl"></span><span class="corner br"></span>
  <figcaption class="mono tc">TC {tc}</figcaption>
</figure>
<style>
  .frame { position: relative; margin: 0; overflow: hidden; border-radius: 2px; background: #18191b; }
  .frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph { position: absolute; inset: 0; display: grid; place-items: center;
    background:
      radial-gradient(120% 90% at 70% 20%, rgba(180,182,182,.12), transparent 60%),
      radial-gradient(80% 80% at 10% 100%, rgba(61,91,127,.30), transparent 60%),
      #18191b; }
  .ph span { font-family: var(--mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .corner { position: absolute; width: 18px; height: 18px; border-color: rgba(242,237,228,.55); border-style: solid; border-width: 0; }
  .tl { top: 12px; left: 12px; border-top-width: 1px; border-left-width: 1px; }
  .tr { top: 12px; right: 12px; border-top-width: 1px; border-right-width: 1px; }
  .bl { bottom: 12px; left: 12px; border-bottom-width: 1px; border-left-width: 1px; }
  .br { bottom: 12px; right: 12px; border-bottom-width: 1px; border-right-width: 1px; }
  .tc { position: absolute; bottom: 14px; right: 38px; font-size: .64rem; color: rgba(242,237,228,.6); letter-spacing: .1em; }
</style>
