---
const { title = 'Have a story to tell?', text = 'Tell us about your project and we will send a plan and a quote within two business days.' } = Astro.props;
---
<section class="cta">
  <div class="wrap cta-inner">
    <h2 class="display">{title}</h2>
    <p>{text}</p>
    <div class="row">
      <a class="btn btn-primary" href="/contact/">Get a quote</a>
      <a class="btn btn-ghost" href="/services/">See packages</a>
    </div>
  </div>
</section>
<style>
  .cta { border-top: 1px solid var(--line); padding: clamp(5rem, 10vw, 8rem) 0; text-align: center;
    background: radial-gradient(60% 80% at 50% 120%, rgba(232,163,61,.18), transparent 70%); }
  .cta h2 { font-size: clamp(2.4rem, 6vw, 4.6rem); }
  .cta p { color: var(--paper-2); max-width: 46ch; margin: 1.2rem auto 2.2rem; }
  .row { display: flex; gap: .8rem; justify-content: center; flex-wrap: wrap; }
</style>
