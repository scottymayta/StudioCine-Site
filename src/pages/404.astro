---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap" style="min-height:80vh;display:grid;place-content:center;text-align:center;gap:1.5rem">
    <p class="mono" style="color:var(--lime)">Scene missing · 404</p>
    <h1 class="display" style="font-size:clamp(2.4rem,7vw,5rem)">Cut to <em>black</em>.</h1>
    <p style="color:var(--paper-2)">That page isn't in the edit.</p>
    <a class="btn btn-primary" href="/" style="justify-self:center">Back to home</a>
  </section>
</Base>
