---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import CTA from '../components/CTA.astro';
import { site, clients, packages, process } from '../data/site.js';

const partner = packages.find((p) => p.id === 'partner');
const offerings = [
  { n: '01', title: 'Video', text: 'Brand films, commercials, interviews, and short-form clips.', href: '/services/#promo' },
  { n: '02', title: 'Podcasts', text: 'Multi-camera video podcasts recorded and edited in studio.', href: '/services/#podcast' },
  { n: '03', title: 'Photography', text: 'Headshots, brand imagery, and event photography.', href: '/services/#photo' },
  { n: '04', title: 'Live', text: 'Livestreams and event coverage for concerts, panels, and galas.', href: '/services/#live' },
];
---
<Base>
  <section class="hero">
    <div class="hero-media">
      {site.reelEmbed
        ? <iframe src={site.reelEmbed} title="StudioCine reel" allow="autoplay; fullscreen" loading="lazy"></iframe>
        : <div class="hero-glow"></div>}
    </div>
    <div class="letterbox top"></div><div class="letterbox bottom"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow mono"><span class="rec"></span>Santa Barbara production studio</p>
      <h1 class="display">Your story,<br /><em>in frame.</em></h1>
      <p class="hero-lede">StudioCine makes cinematic video, podcasts, and photography for businesses, nonprofits, and creators, shot in our Santa Barbara studio or on location.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/contact/">Book a session</a>
        <a class="btn btn-ghost" href="/work/">Watch our work</a>
      </div>
    </div>
    <div class="wrap hero-meta mono">
      <span>34.4208° N, 119.6982° W</span>
      <span>Scroll</span>
    </div>
  </section>

  <section class="clients">
    <div class="wrap clients-inner">
      <p class="mono">Trusted by</p>
      <ul>{clients.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">Everything you need to be <em>seen</em>.</h2>
        <p>One team for concept, production, and post. You get finished content ready for every screen, without hiring a crew yourself.</p>
      </div>
      <div class="offer-grid">
        {offerings.map((o) => (
          <a class="offer" href={o.href}>
            <span class="mono">{o.n}</span>
            <h3 class="display">{o.title}</h3>
            <p>{o.text}</p>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section studio-teaser">
    <div class="wrap split">
      <Frame label="Studio photo" ratio="4 / 5" tc="01:12:08:14" />
      <div>
        <p class="eyebrow mono">The studio</p>
        <h2 class="display big">A real set, ready when you are.</h2>
        <div class="prose" style="margin-top:1.5rem">
          <p>Controlled lighting, clean sound, and a crew that knows the room. Most local shoots happen in an office or a back hallway. Yours will look like it was made for the screen.</p>
        </div>
        <ul class="check-list" style="margin:1.5rem 0 2rem">
          <li>Multi-camera podcast and interview setup</li>
          <li>Professional cinema lighting</li>
          <li>Broadcast-quality audio recording</li>
          <li>Space for product, portrait, and performance shoots</li>
        </ul>
        <a class="btn btn-ghost" href="/studio/">Tour the studio</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap partner">
      <div class="partner-copy">
        <span class="tag">Most popular</span>
        <h2 class="display big">Become a <em>Content Partner</em>.</h2>
        <p>{partner.summary} One shoot a month keeps your feed full and your brand consistent, with no scrambling for content.</p>
      </div>
      <div class="partner-card">
        <p class="price"><span class="display">{partner.price}</span> <span class="mono">{partner.unit}</span></p>
        <ul class="check-list">{partner.includes.map((i) => <li>{i}</li>)}</ul>
        <p class="mono note">{partner.note}</p>
        <a class="btn btn-primary" href="/contact/?package=Content%20Partner">Start a partnership</a>
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display">How it works</h2>
        <p>Simple, clear, and on schedule. Most projects go from first call to final delivery in two to three weeks.</p>
      </div>
      <ol class="steps">
        {process.map((s) => (
          <li>
            <span class="mono">{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding-bottom: 5.5rem; }
  .hero-media { position: absolute; inset: 0; }
  .hero-media iframe { width: 100%; height: 100%; border: 0; transform: scale(1.35); pointer-events: none; opacity: .55; }
  .hero-glow { position: absolute; inset: 0;
    background:
      radial-gradient(55% 60% at 78% 30%, rgba(232,163,61,.30), transparent 70%),
      radial-gradient(40% 50% at 95% 80%, rgba(180,80,40,.18), transparent 70%),
      linear-gradient(180deg, #0d0c0b 0%, #14110d 100%); }
  .hero-glow::after { content: ''; position: absolute; right: 8%; top: 18%; width: min(38vw, 520px); aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(242,237,228,.10); box-shadow: 0 0 0 60px rgba(242,237,228,.025), 0 0 0 140px rgba(242,237,228,.015); }
  .letterbox { position: absolute; left: 0; right: 0; height: clamp(18px, 4vw, 44px); background: #000; z-index: 1; }
  .letterbox.top { top: 0; } .letterbox.bottom { bottom: 0; }
  .hero-inner { position: relative; z-index: 2; }
  .hero h1 { font-size: clamp(3.6rem, 12vw, 10.5rem); }
  .hero-lede { max-width: 48ch; margin-top: 1.8rem; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--paper-2); }
  .hero-cta { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 2.2rem; }
  .hero-meta { position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(30px, 5.5vw, 60px); display: flex; justify-content: space-between; color: var(--muted); }
  @media (max-width: 600px) { .hero-meta { display: none; } .hero { padding-bottom: 4rem; } }

  .clients { border-block: 1px solid var(--line); padding: 1.8rem 0; }
  .clients-inner { display: flex; align-items: center; gap: 2.5rem; flex-wrap: wrap; }
  .clients-inner > p { color: var(--muted); }
  .clients ul { display: flex; gap: clamp(1.5rem, 4vw, 3.5rem); flex-wrap: wrap; }
  .clients li { font-family: var(--serif); font-size: clamp(1.25rem, 2.2vw, 1.7rem); color: var(--paper-2); }

  .offer-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .offer { position: relative; padding: 2rem 1.6rem 2.4rem 0; border-bottom: 1px solid var(--line); transition: background .25s; }
  .offer + .offer { padding-left: 1.6rem; border-left: 1px solid var(--line); }
  .offer .mono { color: var(--tungsten); }
  .offer h3 { font-size: clamp(2rem, 3vw, 2.6rem); margin: 2.5rem 0 .7rem; }
  .offer p { color: var(--paper-2); font-size: .97rem; max-width: 28ch; }
  .offer .arrow { position: absolute; top: 1.8rem; right: 1.2rem; color: var(--muted); transition: transform .25s, color .25s; }
  .offer:hover .arrow { transform: translateX(4px); color: var(--tungsten); }
  @media (max-width: 960px) {
    .offer-grid { grid-template-columns: 1fr 1fr; }
    .offer:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 560px) {
    .offer-grid { grid-template-columns: 1fr; }
    .offer + .offer { padding-left: 0; border-left: 0; }
    .offer h3 { margin-top: 1.2rem; }
  }

  .big { font-size: clamp(2.3rem, 5vw, 4rem); }
  .studio-teaser { background: var(--ink-2); border-block: 1px solid var(--line); }

  .partner { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .partner-copy h2 { margin: 1.4rem 0 1.2rem; }
  .partner-copy p { color: var(--paper-2); max-width: 46ch; }
  .partner-card { border: 1px solid rgba(232,163,61,.45); border-radius: 4px; padding: clamp(1.8rem, 4vw, 2.6rem);
    background: linear-gradient(160deg, rgba(232,163,61,.10), rgba(232,163,61,0) 60%); }
  .price { display: flex; align-items: baseline; gap: .6rem; margin-bottom: 1.6rem; }
  .price .display { font-size: 4.2rem; line-height: 1; }
  .price .mono { color: var(--muted); }
  .note { color: var(--muted); margin: 1rem 0 1.6rem; }
  @media (max-width: 860px) { .partner { grid-template-columns: 1fr; } }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; counter-reset: s; }
  .steps li { border-top: 1px solid var(--paper); padding-top: 1.2rem; }
  .steps .mono { color: var(--tungsten); }
  .steps h3 { font-family: var(--serif); font-weight: 400; font-size: 2rem; margin: .8rem 0 .5rem; }
  .steps p { color: var(--paper-2); font-size: .97rem; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr 1fr; gap: 2.2rem 1.5rem; } }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
