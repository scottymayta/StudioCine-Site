---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Frame from '../components/Frame.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site.js';

// Add your projects here. `embed` takes a YouTube or Vimeo embed URL,
// e.g. https://www.youtube.com/embed/VIDEO_ID or https://player.vimeo.com/video/VIDEO_ID
const projects = [
  { title: 'Brand film', client: 'Arch Motorcycle', type: 'Commercial', embed: '' },
  { title: 'Campaign spot', client: 'Mercedes-Benz', type: 'Commercial', embed: '' },
  { title: 'Brand campaign', client: 'Tigo', type: 'Advertising', embed: '' },
  { title: 'Impact documentary', client: 'Water Wells for Africa', type: 'Nonprofit', embed: '' },
];
---
<Base title="Work" description="Selected video work by StudioCine for brands, nonprofits, and artists.">
  <PageHeader eyebrow="Selected work" title="Work that <em>moves</em> people." lede="Commercials, brand films, and documentaries for clients from Santa Barbara to around the world." />

  <section class="wrap reel">
    {site.reelEmbed
      ? <div class="embed"><iframe src={site.reelEmbed} title="StudioCine demo reel" allow="fullscreen; picture-in-picture" loading="lazy"></iframe></div>
      : <Frame label="Demo reel" tc="00:01:30:00" />}
  </section>

  <section class="section">
    <div class="wrap projects">
      {projects.map((p, i) => (
        <article class="project">
          {p.embed
            ? <div class="embed"><iframe src={p.embed} title={`${p.client}: ${p.title}`} allow="fullscreen; picture-in-picture" loading="lazy"></iframe></div>
            : <Frame label={p.client} tc={`00:0${i + 2}:10:00`} />}
          <div class="meta">
            <h2 class="display">{p.client}</h2>
            <span class="mono">{p.type}</span>
          </div>
          <p>{p.title}</p>
        </article>
      ))}
    </div>
  </section>

  <CTA />
</Base>

<style>
  .reel { margin-bottom: 1rem; }
  .embed { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .projects { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem 1.5rem; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1.2rem; }
  .meta h2 { font-size: 2rem; }
  .meta .mono { color: var(--tungsten); }
  .project p { color: var(--paper-2); margin-top: .2rem; }
  @media (max-width: 700px) { .projects { grid-template-columns: 1fr; } }
</style>
